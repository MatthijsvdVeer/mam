<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Aspire hosting">
    <PackageVersion Include="Aspire.Hosting.AgentFramework.DevUI" Version="1.25.0-preview.261014.1" />
    <PackageVersion Include="Microsoft.Agents.AI.DevUI" Version="1.25.0-preview.261014.1" />
    <!-- Patched version; DevUI pulls in 3.1.7 which has GHSA-qhrr-8q5h-9q3h. -->
    <PackageVersion Include="MessagePack" Version="3.1.12" />
  </ItemGroup>

  <ItemGroup Label="Agent Framework">
    <PackageVersion Include="Microsoft.Agents.AI.Foundry" Version="1.25.0-preview.261014.1" />
    <PackageVersion Include="Microsoft.Agents.AI.Harness" Version="1.25.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Hosting" Version="1.25.0-preview.261014.1" />
    <PackageVersion Include="Microsoft.Agents.AI.Hosting.OpenAI" Version="1.25.0-alpha.261014.1" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
  </ItemGroup>

  <ItemGroup Label="Service defaults">
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.0" />
  </ItemGroup>
</Project>
